{
  "name": "dsh-desktop",
  "version": "0.5.0",
  "description": "DSH Desktop — Tauri 2 shell + Node sidecar for the dsh agent harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "fetch:dsh": "node scripts/fetch-dsh.cjs",
    "fetch:pnpm": "node scripts/fetch-pnpm.cjs",
    "dev:sidecar": "node scripts/dev-sidecar.cjs",
    "build:sidecar": "tsc -p sidecar/tsconfig.json && node scripts/copy-sidecar-static.cjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --bundles nsis",
    "tauri:build:mac": "tauri build --bundles app",
    "bundle-deps": "node scripts/bundle-deps.cjs",
    "gen:icons": "python scripts/gen-icons.py",
    "smoke-test": "node scripts/smoke-test.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "tar": "^7.4.3",
    "undici": "^6.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
