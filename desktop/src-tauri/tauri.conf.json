{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.6.0",
  "identifier": "com.dshd.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:sidecar",
    "devUrl": "http://127.0.0.1:3080",
    "beforeBuildCommand": "pnpm fetch:dsh && node scripts/fetch-node.cjs && node scripts/fetch-pnpm.cjs && pnpm bundle-deps && pnpm build:sidecar",
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../.sidecar-deps/dsh-dist": "sidecar/dsh-dist",
      "../.sidecar-deps/node_modules": "sidecar/node_modules",
      "../.sidecar-deps/pnpm": "sidecar/pnpm",
      "../.sidecar-deps/root": "sidecar",
      "../.sidecar-deps/runtime": "sidecar"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
